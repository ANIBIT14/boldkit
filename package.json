{
  "workspaces": [
    "packages/vue",
    "packages/mcp",
    "packages/cli"
  ],
  "name": "boldkit-site",
  "private": true,
  "version": "3.5.1",
  "description": "A neubrutalism UI component library for React and Vue 3 - Bold, raw, beautiful.",
  "author": "BoldKit Team",
  "license": "MIT",
  "homepage": "https://boldkit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANIBIT14/boldkit.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "neubrutalism",
    "brutalism",
    "tailwindcss",
    "shadcn",
    "radix-ui",
    "design-system"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && npm run llms && npm run themes && npm run contrast && tsc -b && vite build && npm run registry:build && npm run ssg && npm run prerender",
    "build:ci": "npm run sitemap && npm run llms && npm run themes && npm run contrast && tsc -b && vite build && npm run registry:build && npm run ssg",
    "ssg": "tsx scripts/generate-html.ts",
    "themes": "tsx scripts/generate-theme-presets.ts",
    "contrast": "tsx scripts/audit-contrast.ts",
    "prerender": "tsx scripts/prerender.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "llms": "tsx scripts/generate-llms-full.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "registry:sync": "node scripts/sync-registry-from-src.js",
    "registry:audit": "node scripts/audit-registry-imports.mjs",
    "audit:icon-labels": "node scripts/audit-icon-labels.mjs",
    "registry:build": "npm run registry:sync && shadcn build && npm run registry:build:vue && node scripts/build-canvas-effects-registry.js && node scripts/build-registry.js && node scripts/build-mcp-catalog.js",
    "registry:build:vue": "cd packages/vue && node scripts/build-registry.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.5",
    "puppeteer": "^25.3.0",
    "shadcn": "^4.13.1",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
