{
  "name": "@boldkit/mcp",
  "version": "0.2.0",
  "description": "MCP server for BoldKit - search and install neubrutalism UI components (React & Vue) by natural-language description.",
  "author": "BoldKit Team",
  "license": "MIT",
  "homepage": "https://boldkit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANIBIT14/boldkit.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "boldkit",
    "neubrutalism",
    "shadcn",
    "shadcn-vue",
    "ui",
    "components"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "boldkit-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "catalog.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
